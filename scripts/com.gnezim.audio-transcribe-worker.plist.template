<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.gnezim.audio-transcribe-worker</string>
  <key>ProgramArguments</key>
  <array>
    <string>__WORKER_SCRIPT__</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>AUDIO_TRANSCRIBE_WATCH</key>
    <string>__WATCH_DIRECTORY__</string>
    <key>AUDIO_TRANSCRIBE_OUTPUT</key>
    <string>__OUTPUT_DIRECTORY__</string>
    <key>AUDIO_TRANSCRIBE_PROFILE</key>
    <string>default</string>
  </dict>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>10</integer>
  <key>StandardOutPath</key>
  <string>__LOG_DIRECTORY__/audio-transcribe-worker.log</string>
  <key>StandardErrorPath</key>
  <string>__LOG_DIRECTORY__/audio-transcribe-worker.err</string>
</dict>
</plist>
